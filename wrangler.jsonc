{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "findit-preview",
  "main": "apps/api/cloudflare-worker.js",
  "account_id": "2fd40fedbf8b53361c2f2f8cfd49ba8d",
  "compatibility_date": "2026-11-08",
  "compatibility_flags": [
    "nodejs_compat",
    "enable_nodejs_http_server_modules"
  ],
  "alias": {
    "pg": "./apps/api/src/cloudflare/pg-stub.js",
    "@azure/storage-blob": "./apps/api/src/cloudflare/azure-stub.js"
  },
  "vars": {
    "NODE_ENV": "production",
    "FINDIT_RUNTIME": "cloudflare",
    "PUBLIC_API_URL": "https://findit-preview.dressmeai-zzh.workers.dev",
    "MAINTENANCE_MODE": "0",
    "PORT": "4000"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "findit-preview",
      "database_id": "61f9f108-df98-4e75-8f19-aea4cff86559",
      "migrations_dir": "apps/api/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "findit-preview-images"
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}
